# ==========================================
# 1. KERNEL UNLOCKS & DEPENDENCIES
# ==========================================
CONFIG_EXPERT=y
CONFIG_I2C=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_WLAN=y

# ==========================================
# 2. CORE WIRELESS & LED TRIGGERS
# ==========================================
CONFIG_MAC80211_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_MAC80211=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_CRYPTO_CCM=m
CONFIG_CRYPTO_GCM=m
CONFIG_CRYPTO_CMAC=m

# ==========================================
# 3. MEDIATEK ALFA ADAPTER
# ==========================================
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76x02_LIB=m
CONFIG_MT76x02_USB=m
CONFIG_MT76x2_COMMON=m
CONFIG_MT76x2U=m
CONFIG_MT76_LEDS=y

# ==========================================
# 4. WIREGUARD & NETFILTER
# ==========================================
CONFIG_WIREGUARD=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y

# ==========================================
# 5. BADUSB / HID GADGET
# ==========================================
CONFIG_USB_F_HID=y
CONFIG_USB_CONFIGFS_F_HID=y

# ==========================================
# 6. BLUETOOTH USB SUB-DRIVERS
# ==========================================
CONFIG_BT_HCIBTUSB=m
# CONFIG_BT_HCIBTUSB_AUTOSUSPEND is not set
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y

# ==========================================
# 7. SDR & REALTEK RTL28XXU TUNER
# ==========================================
CONFIG_I2C_MUX=m
# CONFIG_MEDIA_SUPPORT_FILTER is not set
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_DVB_CORE=m
CONFIG_DVB_USB_V2=m
CONFIG_DVB_USB_RTL28XXU=m

# ==========================================
# 8. ATHEROS CARL9170 & ATH9K_HTC
# ==========================================
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_HTC_DEBUGFS=y
CONFIG_CARL9170=m

# ==========================================
# 9. USB MITM ETHERNET
# ==========================================
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
