#8e20d7f878c4f21abbbf4ce0328084eeb17a67db
#Feat: Add Bluetooth dongles and legacy Ralink/Realtek Wi-Fi
#03fbfaa6d39c865f811030b71c1cc5dfda37f2de
#Test: Force System V IPC into GKI

# ==========================================
# 0. CORE WIRELESS STACK
# ==========================================
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# ==========================================
# 1. VENDOR GATEKEEPERS (DOORS OPEN)
# ==========================================
CONFIG_WLAN_VENDOR_MEDIATEK=y

# ==========================================
# 2. MEDIATEK ALFA MODULES
# ==========================================
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76x02_LIB=m
CONFIG_MT76x02_USB=m
CONFIG_MT76x2_COMMON=m
CONFIG_MT76x2U=m
